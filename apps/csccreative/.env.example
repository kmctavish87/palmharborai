# Mock mode never calls a paid model and is the default.
AI_PROVIDER=mock

# Optional: comma-separated hostnames when testing dev mode from another device.
# ALLOWED_DEV_ORIGINS=192.168.1.50

# Static deployment under palmharborai.com/csccreative
# STATIC_EXPORT=true
# NEXT_PUBLIC_BASE_PATH=/csccreative

# Phase 2: configure only on the server. Never prefix secrets with NEXT_PUBLIC_.
# OPENAI_API_KEY=
